#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
MILA_COMPILER="${MILA_BIN:-${DIR}/build/mila}"

if [[ ! -x "$MILA_COMPILER" ]]; then
    echo "Error: Mila compiler binary not found at '$MILA_COMPILER'." >&2
    echo "Please build the project first (e.g. cmake --build build)." >&2
    exit 1
fi

LLC=$(command -v llc-18 || command -v llc || true)
CLANG=$(command -v clang-18 || command -v clang || true)

if [[ -z "$LLC" || -z "$CLANG" ]]; then
    echo "Error: 'llc' or 'clang' compiler tools not found in PATH." >&2
    exit 1
fi

OUT_FILE="a.out"
IN_FILE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -o|--output)
            OUT_FILE="$2"
            shift 2
            ;;
        -d|--debug|-v|--verbose|-f|--force)
            shift
            ;;
        -*)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
        *)
            if [[ -z "$IN_FILE" ]]; then
                IN_FILE="$1"
            else
                echo "Error: Multiple input files specified." >&2
                exit 1
            fi
            shift
            ;;
    esac
done

if [[ -z "$IN_FILE" ]]; then
    echo "Usage: $0 <input.mila> [-o <output>]" >&2
    exit 1
fi

InputFileName=$(realpath "$IN_FILE")
OutputFileName=$(realpath "$OUT_FILE")
OutputFileBaseName="${OutputFileName%.*}"

IR_FILE="${OutputFileBaseName}.ir"
S_FILE="${OutputFileBaseName}.s"

# Compilation pipeline: FE -> llc -> clang with fnc.c
"$MILA_COMPILER" < "$InputFileName" > "$IR_FILE"
"$LLC" "$IR_FILE" -o "$S_FILE" -relocation-model=pic
"$CLANG" "$S_FILE" "${DIR}/src/fnc.c" -o "$OutputFileName"
